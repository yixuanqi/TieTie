{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-and-floats",
  "description": "First-party TieTie UI Windows only; core data and clipboard are handled by Rust commands.",
  "windows": ["main", "float_*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-hide"
  ]
}
